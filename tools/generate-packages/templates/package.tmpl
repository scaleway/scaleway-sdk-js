{
  "name": "@scaleway-internal/sdk-{{name}}",
  "version": "1.0.0",
  "description": "Scaleway SDK {{name}}",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.gen.d.ts",
      "default": "./dist/index.gen.js"
    },
    "./*": {
      "types": "./dist/*/index.gen.d.ts",
      "default": "./dist/*/index.gen.js"
    },
   "./metadata": {
      "types": "./dist/metadata.gen.d.ts",
      "default": "./dist/metadata.gen.js"
    },
    "./metadata": {
      "types": "./dist/metadata.gen.d.ts",
      "default": "./dist/metadata.gen.js"
    },
    "./*/metadata": {
      "types": "./dist/*/metadata.gen.d.ts",
      "default": "./dist/*/metadata.gen.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/scaleway/scaleway-sdk-js.git",
    "directory": "packages_generated/{{name}}"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "package:check": "pnpm publint",
    "typecheck": "tsc --noEmit",
    "type:generate": "tsc --declaration -p tsconfig.build.json",
    "build": "vite build --config vite.config.ts && pnpm run type:generate",
    "build:profile": "npx vite-bundle-visualizer -c vite.config.ts"
  },
  "dependencies": {
    "@scaleway/sdk-std": "workspace:^",
    "@scaleway/random-name": "catalog:"
  },
  "peerDependencies": {
     "@scaleway/sdk-client": "workspace:^"
  },
  "devDependencies":{
    "@repo/configs": "workspace:*",
    "@scaleway/sdk-client": "workspace:^"
  }
}
