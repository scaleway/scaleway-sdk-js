{
  "name": "@scaleway-internal/sdk-vps",
  "version": "1.0.0",
  "description": "Scaleway SDK vps",
  "repository": {
    "type": "git",
    "url": "https://github.com/scaleway/scaleway-sdk-js.git",
    "directory": "packages_generated/vps"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.gen.d.ts",
      "default": "./dist/index.gen.js"
    },
    "./*": {
      "types": "./dist/*/index.gen.d.ts",
      "default": "./dist/*/index.gen.js"
    },
    "./metadata": {
      "types": "./dist/metadata.gen.d.ts",
      "default": "./dist/metadata.gen.js"
    },
    "./*/metadata": {
      "types": "./dist/*/metadata.gen.d.ts",
      "default": "./dist/*/metadata.gen.js"
    }
  },
  "scripts": {
    "package:check": "pnpm publint",
    "typecheck": "tsc --noEmit",
    "build": "tsdown --config tsdown.config.ts"
  },
  "dependencies": {
    "@scaleway/random-name": "catalog:",
    "@scaleway/sdk-std": "workspace:^"
  },
  "devDependencies": {
    "@repo/configs": "workspace:*",
    "@scaleway/sdk-client": "workspace:^"
  },
  "peerDependencies": {
    "@scaleway/sdk-client": "workspace:^"
  }
}
