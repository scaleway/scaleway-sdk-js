{
  "name": "root",
  "private": true,
  "workspaces": [
    "packages/*",
    "packages_generated/*",
    "tools/*"
  ],
  "type": "module",
  "scripts": {
    "fix-deps": "pnpm exec manypkg fix && pnpm sync-peer-deps ",
    "prebuild": "pnpm exec generate-packages packages && pnpm exec generate-packages sdk && pnpm exec generate-packages deps && pnpm fix-deps && pnpm format",
    "build:packages": "pnpm turbo run build",
    "build": "pnpm turbo build",
    "typecheck": "pnpm turbo typecheck",
    "build:profile": "cross-env PROFILE=true pnpm run build",
    "doc": "typedoc",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "format:generated": "oxfmt check --write packages_generated",
    "lint": "oxlint  -c .oxlintrc.jsonc --quiet",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:junit": "vitest --reporter=junit --outputFile=test-report.junit.xml",
    "test:ui": "vitest --ui"
  },
  "devDependencies": {
    "@manypkg/cli": "0.25.1",
    "@repo/configs": "workspace:^",
    "@repo/generate-packages": "workspace:*",
    "@repo/pnpm-auto-release": "workspace:*",
    "@scaleway/generate-react-sdk": "workspace:*",
    "@scaleway/oxlint-config": "0.2.3",
    "@scaleway/sync-peer-deps": "1.0.4",
    "@scaleway/tsconfig": "1.1.6",
    "@vitest/coverage-istanbul": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "4.1.11",
    "babel-plugin-annotate-pure-calls": "0.5.0",
    "browserslist": "4.28.7",
    "cross-env": "10.1.0",
    "cross-fetch": "4.1.0",
    "esbuild-plugin-browserslist": "2.0.0",
    "jsdom": "30.0.1",
    "nano-staged": "1.0.2",
    "oxfmt": "0.61.0",
    "oxlint": "1.75.0",
    "oxlint-tsgolint": "7.0.2001",
    "react": "^19.2.8",
    "read-pkg": "10.1.0",
    "shx": "0.4.0",
    "tinyglobby": "0.2.17",
    "turbo": "2.10.7",
    "typedoc": "0.28.20",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "nano-staged": {
    "packages/*/src/**/*.{ts,tsx,js,jsx}": [
      "pnpm run format"
    ],
    "tools/**/*.ts": [
      "pnpm run format"
    ],
    "!(pnpm-lock).y?(a)ml": [
      "pnpm oxfmt --write"
    ],
    "*.md?(x)": [
      "pnpm oxfmt --write"
    ],
    "*.json": [
      "pnpm run format"
    ],
    "(*package).json": [
      "pnpm exec manypkg check"
    ],
    "(*pnpm)-lock": [
      "pnpm exec manypkg check"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": ">=24.18.x  || 26.x",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@11.20.0"
}
